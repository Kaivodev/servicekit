# syntax=docker/dockerfile:1
FROM rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build
RUN cargo install --locked --version 1.263.0 wasm-tools
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY guest/sdk guest/sdk
COPY wit wit
COPY proto proto
RUN cargo build --release --locked -p upstream-gateway

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
COPY --from=build --chmod=0755 /src/target/release/upstream-gateway /app/upstream-gateway
USER 65532:65532
ENTRYPOINT ["/app/upstream-gateway"]
CMD ["--config", "/run/kaivo/inputs/gateway.toml"]
